# Shared secret between the macOS app (or iOS) and the memory service.
# Pick a long random string. Tailscale provides network security; this is
# defense in depth so anyone landed on the host can't poke the service.
MEMORY_BEARER_TOKEN=replace-me-with-a-long-random-string

# Shared secret between the app and the BROWSER gateway (:8083). Its OWN secret,
# deliberately not MEMORY_BEARER_TOKEN: this service drives a real Chromium inside
# your network, and the running deployment already uses a separate token (reusing
# the memory one would 401 every browser tool on the next deploy). Pick a long
# random string, different from the one above.
BROWSER_BEARER_TOKEN=replace-me-with-a-different-long-random-string

# CLI session the streaming relay of the browser panel follows.
# MUST MATCH the app's AGENT_BROWSER_SESSION (default `gemma`, in the
# `personal_agent` repo). If they diverge the browser keeps working and the panel
# just stays blank; the relay compares it against the session the viewer declares
# and closes with a reason naming both. Declared in docker-compose.yml.
BROWSER_STREAM_SESSION=gemma

# URL of the LLM (mlx_vlm.server / similar) that the consolidation engine
# calls when running sleep/reflection cycles.
#
# Defaults to host.docker.internal:8080 which works on Docker Desktop
# (Mac/Windows) where the model runs on the same host. On Linux deployments
# (e.g. a home server reaching the Mac across the LAN), set this to the
# LAN/Tailscale IP of the Mac running the model — Linux's host-gateway
# resolves to the Linux box itself, NOT to the model host.
MODEL_URL=http://host.docker.internal:8080
